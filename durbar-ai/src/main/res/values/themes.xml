<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DurbarAi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/satin_blue</item>
        <item name="colorPrimaryVariant">@color/navy_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorAccent">@color/ai_blue</item>
        <item name="android:colorAccent">@color/ai_blue</item>
        <item name="colorControlActivated">@color/ai_blue</item>
        <item name="android:colorControlActivated">@color/ai_blue</item>
        <item name="android:textColorHighlight">#4D0B3BFF</item>
        <item name="android:statusBarColor">@color/ai_bg</item>
        <item name="android:navigationBarColor">@color/ai_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AiSelectionOverlay" parent="">
        <item name="colorAccent">@color/ai_blue</item>
        <item name="android:colorAccent">@color/ai_blue</item>
        <item name="colorControlActivated">@color/ai_blue</item>
        <item name="android:colorControlActivated">@color/ai_blue</item>
        <item name="android:textColorHighlight">#4D0B3BFF</item>
    </style>

    <style name="AppBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="AiModelSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AiModelSheet</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="AiModelSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/AppBottomSheetShape</item>
        <item name="shapeAppearanceOverlay">@style/AppBottomSheetShape</item>
    </style>

    <style name="AiEditTextTheme" parent="ThemeOverlay.AppCompat">
        <item name="colorAccent">@color/ai_blue</item>
        <item name="colorControlActivated">@color/ai_blue</item>
    </style>

</resources>